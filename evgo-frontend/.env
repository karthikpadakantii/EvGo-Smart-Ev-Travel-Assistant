# Base URL of the Spring Cloud Gateway (API Gateway) that routes to all microservices.
# Include the /api prefix if your gateway routes are defined with a Path=/api/**
# predicate + StripPrefix filter, as in the sample application.properties.
VITE_API_BASE_URL=http://localhost:8080/api

# No client-side map API key needed: the map renders OpenStreetMap tiles directly
# (free, no key required), and routing itself is calculated server-side by your
# Integration Service via OpenRouteService.
